    Private Sub CmdView_Click(sender As Object, e As EventArgs) Handles CmdView.Click
        Checkdaterangevalidate(Dtp_FromDate.Value, Dtp_ToDate.Value)
        If chkdatevalidate = False Then Exit Sub
        Dim Viewer As New ReportViwer
        Dim i As Integer
        Dim sqlstring As String

        Dim r As New Crpt_Recon_BRC
        sqlstring = ""
        sqlstring = "SELECT G.BOOKINGNO,PARTYDATE,ASSOCIATENAME,MCODE,DESCRIPTION,VENUE,OCCUPANCY,SUM(FOODBILL) AS FOODBILL,SUM(NONFOODBILL) AS NONFOODBILL,SUM(TOTALTAX) AS TOTALTAX, "
        sqlstring = sqlstring & " ISNULL(StoreConsum,0) AS StoreConsum,ISNULL(OT_Kit,0) AS OT_Kit,ISNULL(OT_Service,0) AS OT_Service,ISNULL(Cont_ItemCost,0) AS Cont_ItemCost from Get_Together_Rpt G "
        sqlstring = sqlstring & " Left Outer Join PARTY_OTHERENTRY O ON G.BOOKINGNO = O.BOOKINGNO "
        sqlstring = sqlstring & " WHERE PARTYDATE BETWEEN '" & Format(Dtp_FromDate.Value, "dd-MMM-yyyy") & "' AND '" & Format(Dtp_ToDate.Value, "dd-MMM-yyyy") & "'"
        sqlstring = sqlstring & " GROUP BY G.BOOKINGNO,PARTYDATE,ASSOCIATENAME,MCODE,DESCRIPTION,VENUE,OCCUPANCY,ISNULL(StoreConsum,0),ISNULL(OT_Kit,0),ISNULL(OT_Service,0),ISNULL(Cont_ItemCost,0) ORDER BY G.BOOKINGNO"
        gconnection.getDataSet(sqlstring, "Get_Together_Rpt")
        If gdataset.Tables("Get_Together_Rpt").Rows.Count > 0 Then
            Call Viewer.GetDetails1(sqlstring, "Get_Together_Rpt", r)
            Viewer.TableName = "Get_Together_Rpt"

            Dim TXTOBJ1 As CrystalDecisions.CrystalReports.Engine.TextObject
            TXTOBJ1 = r.ReportDefinition.ReportObjects("Text19")
            TXTOBJ1.Text = MyCompanyName

            Dim TXTOBJ16 As CrystalDecisions.CrystalReports.Engine.TextObject
            TXTOBJ16 = r.ReportDefinition.ReportObjects("Text20")
            TXTOBJ16.Text = "Get-Together Report Period From " & Format(Dtp_FromDate.Value, "dd.MM.yyyy") & "  To" & " " & Format(Dtp_ToDate.Value, "dd.MM.yyyy") & ""
            Viewer.Show()
        Else
            MessageBox.Show("NO RECORDS TO DISPLAY", MyCompanyName, MessageBoxButtons.OK, MessageBoxIcon.Error)
        End If

    End Sub
